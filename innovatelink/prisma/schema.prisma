// InnovateLink Palestine — data model (PRD §5)
// Field names are snake_case and used as-is in code.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  company_admin
  company_member
  student
  researcher
  university_coordinator
  platform_coordinator
  platform_admin
}

enum UserStatus {
  pending
  active
  suspended
}

enum OrgType {
  company
  university
  platform
  partner
}

enum OrgSize {
  micro
  small
  medium
  large
}

enum OrgStatus {
  pending
  active
  suspended
}

enum Lang {
  ar
  en
}

enum Visibility {
  public
  selected_orgs
  confidential
}

enum ChallengeCategory {
  operations
  product_dev
  digital_automation
  energy_water_waste
  quality_manufacturing
  market_logistics
  research_tech
}

enum ChallengeStatus {
  draft
  submitted
  needs_info
  published
  matched
  in_progress
  solved
  closed
}

enum ProjectType {
  graduation_project
  research_output
  prototype
  technology
}

enum ProjectStatus {
  draft
  pending_approval
  published
  in_collaboration
  commercializing
  archived
}

enum IpStatus {
  none
  disclosed
  filed
  granted
  licensed
}

enum SupportNeed {
  technical
  funding
  mentoring
  lab_access
  market_access
}

enum Seeking {
  showcase
  industry_partner
  licensing
  startup
  consulting
}

enum MatchTargetType {
  project
  researcher
  lab
}

enum MatchStatus {
  suggested
  shortlisted
  accepted_by_company
  accepted_by_academic
  confirmed
  rejected
}

enum MatchSource {
  ai
  manual
}

enum WorkspaceStatus {
  setup
  active
  paused
  completed
  cancelled
}

enum WsRole {
  company_rep
  mentor
  supervisor
  student
  coordinator
}

enum MilestoneStatus {
  pending
  in_progress
  done
}

enum TaskStatus {
  todo
  doing
  done
}

enum CommercializationStage {
  ip_assessment
  market_validation
  prototype_refinement
  business_model
  investment_readiness
  market_entry
}

enum CommercializationPathway {
  licensing
  startup
  product_sale
  technical_service
  process_improvement
}

enum SubjectType {
  challenge
  project
}

enum AccessRequestStatus {
  pending
  approved
  rejected
}

enum ContactTargetType {
  challenge
  project
  researcher
  lab
}

enum ContactStatus {
  pending
  accepted
  declined
}

// ───────────────────────────── Identity ─────────────────────────────

model Organization {
  id            String     @id @default(uuid()) @db.Uuid
  type          OrgType
  name_ar       String
  name_en       String?
  sector_id     String?    @db.Uuid
  city          String?
  size          OrgSize?
  email_domains String[]   @default([])
  status        OrgStatus  @default(pending)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  deleted_at    DateTime?

  sector     Sector?     @relation(fields: [sector_id], references: [id])
  users      User[]
  challenges Challenge[]
  projects   Project[]
  labs       Lab[]

  @@map("organizations")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  password_hash    String
  full_name        String
  role             Role
  status           UserStatus @default(pending)
  locale           Lang       @default(ar)
  org_id           String     @db.Uuid
  email_verified_at DateTime?
  failed_logins    Int        @default(0)
  locked_until     DateTime?
  consent_version  String?
  email_prefs      Json       @default("{}")
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  deleted_at       DateTime?

  org              Organization       @relation(fields: [org_id], references: [id])
  sessions         Session[]
  researcher       ResearcherProfile?
  notifications    Notification[]
  tokens           VerificationToken[]
  ws_memberships   WorkspaceMember[]

  @@index([org_id])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  token_hash   String   @unique
  user_id      String   @db.Uuid
  expires_at   DateTime
  last_seen_at DateTime @default(now())
  ip           String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  purpose    String // "verify_email" | "reset_password"
  token_hash String   @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model ResearcherProfile {
  id               String                       @id @default(uuid()) @db.Uuid
  user_id          String                       @unique @db.Uuid
  department       String?
  title            String?
  expertise_tags   String[]                     @default([])
  bio              String?
  publications_url String?
  availability     String?
  lang             Lang                         @default(ar)
  embedding        Unsupported("vector")?
  created_at       DateTime                     @default(now())
  updated_at       DateTime                     @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("researcher_profiles")
}

model Lab {
  id              String                 @id @default(uuid()) @db.Uuid
  org_id          String                 @db.Uuid
  name            String
  description     String
  equipment       String[]               @default([])
  services        String?
  contact_user_id String?                @db.Uuid
  lang            Lang                   @default(ar)
  embedding       Unsupported("vector")?
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  deleted_at      DateTime?

  org Organization @relation(fields: [org_id], references: [id])

  @@map("labs")
}

model Sector {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  name_ar    String
  name_en    String
  parent_id  String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent   Sector?        @relation("SectorTree", fields: [parent_id], references: [id])
  children Sector[]       @relation("SectorTree")
  orgs     Organization[]
  challenges Challenge[]
  projects Project[]

  @@map("sectors")
}

model Tag {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  name_ar    String
  name_en    String
  parent_id  String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tags")
}

// ───────────────────────────── Challenges ─────────────────────────────

model Challenge {
  id                       String                 @id @default(uuid()) @db.Uuid
  org_id                   String                 @db.Uuid
  created_by               String                 @db.Uuid
  title                    String
  public_title             String?
  category                 ChallengeCategory?
  sector_id                String?                @db.Uuid
  tags                     String[]               @default([])
  problem_statement        String?
  current_situation        String?
  desired_outcome          String?
  constraints              String?
  business_impact          Json?
  resources_offered        Json?
  expected_duration_months Int?
  visibility               Visibility             @default(public)
  visibility_org_ids       String[]               @default([]) @db.Uuid
  status                   ChallengeStatus        @default(draft)
  review_note              String?
  ai_diagnosis             Json?
  lang                     Lang                   @default(ar)
  embedding                Unsupported("vector")?
  published_at             DateTime?
  closed_at                DateTime?
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt
  deleted_at               DateTime?

  org     Organization @relation(fields: [org_id], references: [id])
  sector  Sector?      @relation(fields: [sector_id], references: [id])
  matches Match[]

  @@index([status])
  @@index([org_id])
  @@map("challenges")
}

model ChallengeCluster {
  id            String   @id @default(uuid()) @db.Uuid
  label         String
  challenge_ids String[] @db.Uuid
  similarity    Float
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("challenge_clusters")
}

// ───────────────────────────── Projects ─────────────────────────────

model Project {
  id                  String                 @id @default(uuid()) @db.Uuid
  org_id              String                 @db.Uuid
  created_by          String                 @db.Uuid
  type                ProjectType
  title               String
  public_title        String?
  summary             String?
  problem_addressed   String?
  sector_id           String?                @db.Uuid
  tags                String[]               @default([])
  applications        String?
  team_member_ids     String[]               @default([]) @db.Uuid
  supervisor_id       String?                @db.Uuid
  trl                 Int?
  evidence            String?
  demo_url            String?
  media_doc_ids       String[]               @default([]) @db.Uuid
  potential_customers String?
  ip_status           IpStatus               @default(none)
  collaboration_terms String?
  support_needs       SupportNeed[]          @default([])
  seeking             Seeking[]              @default([])
  visibility          Visibility             @default(public)
  visibility_org_ids  String[]               @default([]) @db.Uuid
  status              ProjectStatus          @default(draft)
  review_note         String?
  lang                Lang                   @default(ar)
  embedding           Unsupported("vector")?
  published_at        DateTime?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  deleted_at          DateTime?

  org              Organization           @relation(fields: [org_id], references: [id])
  sector           Sector?                @relation(fields: [sector_id], references: [id])
  commercialization CommercializationCase?
  ip_record        IpRecord?

  @@index([status])
  @@index([org_id])
  @@map("projects")
}

// ───────────────────────────── Matching ─────────────────────────────

model Match {
  id               String          @id @default(uuid()) @db.Uuid
  challenge_id     String          @db.Uuid
  target_type      MatchTargetType
  target_id        String          @db.Uuid
  score            Float
  rationale        String
  criteria_scores  Json
  status           MatchStatus     @default(suggested)
  source           MatchSource     @default(ai)
  company_accepted_at  DateTime?
  academic_accepted_at DateTime?
  rejection_reason String?
  reviewed_by      String?         @db.Uuid
  ai_run_id        String?         @db.Uuid
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  challenge Challenge  @relation(fields: [challenge_id], references: [id])
  workspace Workspace?

  @@unique([challenge_id, target_type, target_id])
  @@map("matches")
}

// ───────────────────────────── Workspaces ─────────────────────────────

model Workspace {
  id            String          @id @default(uuid()) @db.Uuid
  match_id      String?         @unique @db.Uuid
  challenge_id  String          @db.Uuid
  project_id    String?         @db.Uuid
  title         String
  objectives    String?
  status        WorkspaceStatus @default(setup)
  start_date    DateTime?
  end_date      DateTime?
  course_code   String?
  semester      String?
  agreement_doc_id String?      @db.Uuid
  final_report  Json?
  rating        Int?
  rating_comment String?
  impact        Json?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  deleted_at    DateTime?

  match      Match?            @relation(fields: [match_id], references: [id])
  members    WorkspaceMember[]
  milestones Milestone[]
  meetings   MeetingNote[]
  updates    ProgressUpdate[]

  @@map("workspaces")
}

model WorkspaceMember {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String   @db.Uuid
  user_id      String   @db.Uuid
  ws_role      WsRole
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id])

  @@unique([workspace_id, user_id])
  @@map("workspace_members")
}

model Milestone {
  id           String          @id @default(uuid()) @db.Uuid
  workspace_id String          @db.Uuid
  title        String
  due_date     DateTime?
  status       MilestoneStatus @default(pending)
  order        Int             @default(0)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@map("milestones")
}

model Task {
  id           String     @id @default(uuid()) @db.Uuid
  milestone_id String     @db.Uuid
  title        String
  assignee_id  String?    @db.Uuid
  status       TaskStatus @default(todo)
  due_date     DateTime?
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  milestone Milestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Document {
  id             String    @id @default(uuid()) @db.Uuid
  owner_type     String // challenge | project | workspace | ip_record | admin_template
  owner_id       String    @db.Uuid
  file_key       String
  filename       String
  mime           String
  size           Int
  version        Int       @default(1)
  previous_id    String?   @db.Uuid
  uploaded_by    String    @db.Uuid
  completed      Boolean   @default(false)
  extracted_text String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  chunks DocumentChunk[]

  @@index([owner_type, owner_id])
  @@map("documents")
}

model DocumentChunk {
  id          String                 @id @default(uuid()) @db.Uuid
  document_id String                 @db.Uuid
  idx         Int
  page        Int?
  text        String
  embedding   Unsupported("vector")?
  created_at  DateTime               @default(now())
  updated_at  DateTime               @updatedAt

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model MeetingNote {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String   @db.Uuid
  held_at      DateTime
  attendees    String[] @default([])
  notes        String
  action_items String[] @default([])
  created_by   String   @db.Uuid
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("meeting_notes")
}

model ProgressUpdate {
  id              String   @id @default(uuid()) @db.Uuid
  workspace_id    String   @db.Uuid
  author_id       String   @db.Uuid
  body            String
  prototype_stage String?
  test_results    String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("progress_updates")
}

// ───────────────────────────── Commercialization & IP ─────────────────────────────

model CommercializationCase {
  id             String                   @id @default(uuid()) @db.Uuid
  project_id     String                   @unique @db.Uuid
  stage          CommercializationStage   @default(ip_assessment)
  pathway        CommercializationPathway
  checklist      Json
  coordinator_id String                   @db.Uuid
  notes          String?
  created_at     DateTime                 @default(now())
  updated_at     DateTime                 @updatedAt

  project Project @relation(fields: [project_id], references: [id])

  @@map("commercialization_cases")
}

model IpRecord {
  id               String   @id @default(uuid()) @db.Uuid
  project_id       String?  @unique @db.Uuid
  workspace_id     String?  @unique @db.Uuid
  ip_status        IpStatus @default(none)
  owners           Json // [{name, org_id?, share}]
  background_ip    String?
  agreement_doc_id String?  @db.Uuid
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  project Project? @relation(fields: [project_id], references: [id])

  @@map("ip_records")
}

// ───────────────────────────── Access & contact ─────────────────────────────

model AccessRequest {
  id           String              @id @default(uuid()) @db.Uuid
  subject_type SubjectType
  subject_id   String              @db.Uuid
  user_id      String              @db.Uuid
  message      String?
  status       AccessRequestStatus @default(pending)
  decided_by   String?             @db.Uuid
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  @@map("access_requests")
}

model AccessGrant {
  id           String      @id @default(uuid()) @db.Uuid
  subject_type SubjectType
  subject_id   String      @db.Uuid
  user_id      String      @db.Uuid
  granted_by   String      @db.Uuid
  nda_version  String
  revoked_at   DateTime?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@index([subject_type, subject_id, user_id])
  @@map("access_grants")
}

model NdaAcceptance {
  id           String      @id @default(uuid()) @db.Uuid
  subject_type SubjectType
  subject_id   String      @db.Uuid
  user_id      String      @db.Uuid
  nda_version  String
  nda_text     String
  ip_address   String
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@map("nda_acceptances")
}

model ContactRequest {
  id           String            @id @default(uuid()) @db.Uuid
  from_user_id String            @db.Uuid
  target_type  ContactTargetType
  target_id    String            @db.Uuid
  message      String
  status       ContactStatus     @default(pending)
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  @@map("contact_requests")
}

// ───────────────────────────── Platform ─────────────────────────────

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  type       String
  payload    Json
  read_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@map("notifications")
}

model AiRun {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String
  user_id    String?  @db.Uuid
  input_ref  String?
  input_hash String?
  model      String
  tokens_in  Int      @default(0)
  tokens_out Int      @default(0)
  latency_ms Int      @default(0)
  output     Json?
  error      String?
  feedback   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, created_at])
  @@index([input_hash])
  @@map("ai_runs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actor_id    String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String?
  diff        Json?
  ip          String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

model Setting {
  key        String   @id
  value      Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("settings")
}

# ── Core ──
DATABASE_URL=postgresql://innovate:innovate@localhost:5432/innovatelink
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# ── AI (PRD §4 — provider names appear only inside src/lib/ai) ──
# mock | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=256
AI_ALLOW_CONFIDENTIAL=false
AI_DAILY_LIMIT_PER_USER=30

# ── Storage (S3-compatible, e.g. MinIO) ──
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=innovatelink
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Mail ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InnovateLink Palestine <no-reply@innovatelink.ps>"

# ── Observability ──
SENTRY_DSN=
LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MIN=10
